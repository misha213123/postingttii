HOST=127.0.0.1
PORT=8765

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8765/auth/youtube/callback
YOUTUBE_PRIVACY_STATUS=public

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://127.0.0.1:8765/auth/tiktok/callback
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
TIKTOK_ENABLED=false

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8765/auth/instagram/callback
# Instagram Meta application 1: slots 1–5.
# The optional second Instagram Meta application is used for slots 6–8.
INSTAGRAM_CLIENT_ID_2=
INSTAGRAM_CLIENT_SECRET_2=
INSTAGRAM_REDIRECT_URI_2=
INSTAGRAM_GRAPH_VERSION=v25.0
PUBLIC_BASE_URL=
# UTF-8 TXT file with Instagram caption blocks separated by a line containing ---
# By default reads DATA_DIR/instagram_caption_templates.txt (kept private via .gitignore)
INSTAGRAM_CAPTION_TEMPLATES_FILE=data/instagram_caption_templates.txt

# addy.io — Account Manager email aliases
ADDY_API_TOKEN=
ADDY_BASE_URL=https://app.addy.io
ADDY_TIMEOUT_SECONDS=20

# Minimum pause between successful posts to the same account
POST_COOLDOWN_MINUTES=15

UPLOAD_DIR=videos/inbox
POSTED_DIR=videos/posted
FAILED_DIR=videos/failed
DATA_DIR=data

# Optional: full path to Chrome/Edge if auto-detection fails
BROWSER_EXECUTABLE=

# Browser used by the guided TikTok registration flow: edge, chrome, or auto
TIKTOK_BROWSER=edge
